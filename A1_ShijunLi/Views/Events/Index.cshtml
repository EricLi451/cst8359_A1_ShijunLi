@model List<A1_ShijunLi.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>
<p>Select an event to manage attendees.</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@item.Location</td>
                <td>
                    <a asp-controller="Events" asp-action="Manage" asp-route-id="@item.Id" class="btn btn-primary">
                        Manage Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>