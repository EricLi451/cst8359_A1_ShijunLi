@model A1_ShijunLi.Models.Event

@{
    ViewData["Title"] = "Manage Attendees";
}

<h2>Manage Attendees – @Model.Title</h2>

@if (ViewData["SuccessMessage"] != null)
{
    <div class="alert alert-info">
        @ViewData["SuccessMessage"]
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        Sign Up for @Model.Title
    </div>
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input type="text" class="form-control" id="name" name="name" required>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>
            <button type="submit" class="btn btn-success">Sign Up</button>
            <a asp-action="Index" class="btn btn-secondary">Back to Events</a>
        </form>
    </div>
</div>

<h3>Current Attendees (@Model.Attendees.Count)</h3>

@if (Model.Attendees.Count == 0)
{
    <p>No attendees yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var attendee in Model.Attendees)
        {
            <li class="list-group-item">
                <strong>@attendee.Name</strong> (@attendee.Email)
            </li>
        }
    </ul>
}